server {
    listen 80;

    # Keep redirects relative so they work behind a reverse proxy
    absolute_redirect off;

    # Generated at start-up from BASE_PATH (see base-path.sh): strips the URL
    # prefix if the reverse proxy forwards it unchanged
    include /etc/nginx/base-path.conf;
    location / {
        root /usr/share/nginx/html;
        index unresolvable-file-html.html;
        try_files $uri @index;
    }

    # Health (docs/health-checks.md); serving files needs nothing to be ready
    location ~ ^/(livez|readyz)$ {
        default_type application/health+json;
        return 200 '{"status":"pass"}';
    }

    # Resolve upstreams through the container's DNS on each request rather than once
    # at startup: a recreated container can come back on another address –
    # even the one the other DVA API had, crossing the two dashboards.
    # A variable in proxy_pass is what makes nginx re-resolve.
    # The nameserver(s) come from the container's /etc/resolv.conf (filled in by
    # the nginx image when NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set), so this works
    # with Docker's embedded DNS as well as with Kubernetes' cluster DNS.
    # Note: nginx's resolver ignores DNS search domains, so in Kubernetes the
    # upstream URLs must use fully qualified names (<svc>.<ns>.svc.cluster.local).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/vla {
        set $vla_manager ${DVA_VLA_MANAGER_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $vla_manager;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        set $dva_api ${DVA_API_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $dva_api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # This seperate location is so the no cache policy only applies to the index and nothing else.
    location @index {
        root /usr/share/nginx/html;
        add_header Cache-Control no-cache;
        expires 0;
        try_files /index.html =404;
    }
}
