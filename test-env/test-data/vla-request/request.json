{
  "name": "Recent and valid data",
  "description": {
    "purpose": "Data is recent and valid"
  },
  "schema": [
    {
      "name": "data",
      "logicalType": "object",
      "properties": [
        {
          "name": "timestamp",
          "logicalType": "string"
        },
        {
          "name": "result",
          "logicalType": "integer"
        }
      ],
      "quality": [
        {
          "type": "custom",
          "engine": "JQ",
          "implementation": "{ success: .timestamp >= '20250101T0000Z' }"
        },
        {
          "type": "custom",
          "engine": "JQ",
          "implementation": "{ success: .result >= 1 and .result <= 5 }"
        }
      ]
    }
  ]
}
