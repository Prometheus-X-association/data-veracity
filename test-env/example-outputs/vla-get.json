[
  {
    "apiVersion": "v3.0.2",
    "kind": "DataContract",
    "version": "0.1.0",
    "status": "active",
    "description": {
      "purpose": "Data is recent and valid"
    },
    "schema": [
      {
        "name": "data",
        "logicalType": "object",
        "properties": [
          {
            "name": "timestamp",
            "logicalType": "string"
          },
          {
            "name": "result",
            "logicalType": "integer"
          }
        ],
        "quality": [
          {
            "type": "custom",
            "engine": "JQ",
            "implementation": "{ success: .timestamp >= '20250101T0000Z' }"
          },
          {
            "type": "custom",
            "engine": "JQ",
            "implementation": "{ success: .result >= 1 and .result <= 5 }"
          }
        ]
      }
    ]
  },
  {
    "apiVersion": "v3.0.2",
    "kind": "DataContract",
    "version": "0.1.0",
    "status": "active",
    "description": {
      "purpose": "Data has given timestmap"
    },
    "schema": [
      {
        "name": "data",
        "logicalType": "object",
        "properties": [
          {
            "name": "timestamp",
            "logicalType": "string"
          },
          {
            "name": "result",
            "logicalType": "integer"
          }
        ],
        "quality": [
          {
            "type": "custom",
            "engine": "JQ",
            "implementation": "{ success: .date == \"20250101\" }"
          }
        ]
      }
    ]
  }
]
